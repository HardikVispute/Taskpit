# ==============================================================================
# TaskPit Environment Configuration Example
# Copy this file to .env.local and fill in the values.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Transaction pooler connection string (port 6543) for application services
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection string (port 5432) for Drizzle migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Public API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Side Secret Key (NEVER expose to client-side bundles)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# TaskPit MCP Integration Auth
# Secret token used by external AI assistants (e.g. Claude Desktop, Cursor) to connect to TaskPit MCP
TASKPIT_API_KEY="tp_dev_test_placeholder_key"
